server {
    listen 80;
    server_name _;

    # Trunk build output (often /dist in your image)
    root /usr/share/nginx/html;
    index index.html;

    location = /api { return 308 /api/; }

    # ---- API proxy ----
    location ^~ /api/ {
      proxy_pass ${BACKEND_URL};

      add_header X-Debug-Upstream $upstream_addr always;
      add_header X-Debug-Status   $upstream_status always;
      proxy_ssl_server_name on;


      proxy_set_header Host              ${BACKEND_URL_HOST};

      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

    }
    # ---- SPA routing (Yew client-side routes) ----
    location / {
        try_files $uri $uri/ /index.html;
    }
}

